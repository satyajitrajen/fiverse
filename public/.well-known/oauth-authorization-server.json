{
  "issuer": "https://fiversesystems.com",
  "authorization_endpoint": "https://fiversesystems.com/oauth/authorize",
  "token_endpoint": "https://fiversesystems.com/api/v1/oauth/token",
  "jwks_uri": "https://fiversesystems.com/.well-known/jwks.json",
  "registration_endpoint": "https://fiversesystems.com/api/v1/agents/register",
  "scopes_supported": [
    "openid",
    "profile",
    "email",
    "read:services",
    "read:case-studies",
    "write:inquiries",
    "read:blueprints"
  ],
  "response_types_supported": [
    "code",
    "token"
  ],
  "response_modes_supported": [
    "query",
    "fragment"
  ],
  "grant_types_supported": [
    "authorization_code",
    "client_credentials",
    "urn:ietf:params:oauth:grant-type:token-exchange"
  ],
  "token_endpoint_auth_methods_supported": [
    "client_secret_post",
    "client_secret_basic",
    "private_key_jwt"
  ],
  "code_challenge_methods_supported": [
    "S256"
  ],
  "service_documentation": "https://fiversesystems.com/auth.md",
  "agent_auth": {
    "skill": "https://fiversesystems.com/auth.md",
    "register_uri": "https://fiversesystems.com/api/v1/agents/register",
    "claim_uri": "https://fiversesystems.com/api/v1/agents/claims",
    "revocation_uri": "https://fiversesystems.com/api/v1/agents/revoke",
    "identity_types_supported": [
      "identity_assertion",
      "anonymous"
    ],
    "identity_assertion": {
      "assertion_types_supported": [
        "urn:ietf:params:oauth:token-type:id-jag",
        "verified_email"
      ],
      "credential_types_supported": [
        "bearer_token",
        "api_key"
      ]
    },
    "anonymous": {
      "credential_types_supported": [
        "bearer_token"
      ]
    },
    "events_supported": [
      "https://schemas.openid.net/secevent/oauth/event-type/token-revocation"
    ]
  }
}
